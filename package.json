{
  "name": "pop-ing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild js/popup.js --bundle --format=iife --target=es2022 --minify --outfile=js/app.bundle.js && node scripts/prepare-dist.mjs",
    "test": "node tests/camera-collision.test.mjs && node tests/modules.test.mjs && node tests/avatar-zoom.test.mjs && node tests/avatar-textures.test.mjs",
    "format": "prettier --write index.html \"css/*.css\" \"js/*.js\" \"tests/*.mjs\" data/project.json data/scene.json data/objects.json --ignore-path .prettierignore"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "prettier": "3.6.2"
  }
}
